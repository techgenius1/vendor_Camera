        name: "GoogleCameraUltraLegacy",
        owner: "google",
        apk: "GoogleCameraUltraLegacy.apk",
        overrides: ["Camera2", "Snap", "Aperture"],
        presigned: true,
        dex_preopt: {
                enabled: false,
        },
        privileged: true,
        product_specific: true,
}

